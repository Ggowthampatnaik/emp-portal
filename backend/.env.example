# ---------------------------------------------------------------------------
# Copy to backend/.env for local development. Never commit the real .env.
# In Azure these become App Settings backed by Key Vault references.
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=1
DJANGO_ENV=dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
TIME_ZONE=Asia/Kolkata

# Database (Docker Compose default)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/emp_portal
# Set these two to 1 to run without Docker (SQLite + in-memory cache)
USE_SQLITE=0
USE_LOCMEM_CACHE=0

# Cache / queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Frontend / CORS
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Microsoft Entra ID (from the app registration)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
# Refuse Microsoft sign-ins that did not use MFA (checks the token's amr claim).
# Turn MFA on in Entra first: Conditional Access for this app, or Security Defaults.
ENTRA_REQUIRE_MFA=true
# Once SSO is live set this to false; only the break-glass accounts listed below
# keep email/password sign-in (comma-separated - the way in if Entra is down).
PASSWORD_SIGN_IN_ENABLED=true
PASSWORD_SIGN_IN_ALLOWED_EMAILS=

# Portal JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=employee-documents

# Email
# Leave EMAIL_HOST blank and mail prints to the runserver console. Fill it in
# and the SMTP backend is selected automatically - EMAIL_BACKEND only needs
# setting to override that choice. Check it with:
#     python manage.py mailtest you@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@trigyan.io
# Gmail: smtp.gmail.com:587, TLS, and an App Password (not the account
# password) as EMAIL_HOST_PASSWORD.
# Microsoft 365: smtp.office365.com:587, TLS, a licensed mailbox as
# EMAIL_HOST_USER, and DEFAULT_FROM_EMAIL set to that same address.

# Monitoring
APPLICATIONINSIGHTS_CONNECTION_STRING=
