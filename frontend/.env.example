# Copy to frontend/.env.local for development. Only VITE_* vars reach the bundle,
# so never put a secret here - these values are public by design.
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_PROXY=http://localhost:8000

# Microsoft Entra ID app registration (SPA platform, no client secret)
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback
# API scope exposed by the backend app registration
VITE_ENTRA_API_SCOPE=api://<backend-client-id>/access_as_user
# false = Microsoft sign-in only (match PASSWORD_SIGN_IN_ENABLED on the backend).
# Break-glass admins can still reach the password form at /login?local=1.
VITE_PASSWORD_SIGN_IN=true

VITE_APP_NAME=Trigyan Employee Portal
